{
  "name": "@promax/promax-bundle",
  "version": "0.1.36",
  "private": true,
  "type": "module",
  "main": "lib/index.mjs",
  "types": "lib/index.d.mts",
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "default": "./lib/index.mjs"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "presets"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --format esm --platform node --dts --out-dir lib",
    "typecheck": "tsc --noEmit -p ../../tsconfig.json"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@promax/promax-report": "file:../../../promax-end/packages/promax-report",
    "@promax/promax-ui-brand": "file:../promax-ui-brand",
    "@promax/promax-ui-console": "file:../promax-ui-console",
    "@promax/promax-ui-layout": "file:../promax-ui-layout"
  },
  "dependencies": {
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-mcp-client": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.1",
    "exceljs": "4.4.0",
    "mammoth": "1.12.2",
    "pdf-parse": "2.4.5",
    "yaml": "2.8.1"
  }
}
