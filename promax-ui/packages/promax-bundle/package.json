{
  "name": "@promax/promax-bundle",
  "version": "0.1.10",
  "private": true,
  "type": "module",
  "main": "lib/index.mjs",
  "types": "lib/index.d.mts",
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "default": "./lib/index.mjs"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" }
  },
  "files": ["lib", "cordis.patch.yml", "presets"],
  "scripts": {
    "build": "tsdown src/index.ts --format esm --platform node --dts --out-dir lib",
    "typecheck": "tsc --noEmit -p ../../tsconfig.json"
  },
  "devDependencies": {
    "@promax/promax-report": "file:../../../promax-end/packages/promax-report",
    "@promax/promax-ui-brand": "file:../promax-ui-brand",
    "@promax/promax-ui-console": "file:../promax-ui-console",
    "@promax/promax-ui-layout": "file:../promax-ui-layout"
  }
}
